{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pytest:*)",
      "Bash(ts:*)",
      "Bash(source ~/.zshenv:*)",
      "WebSearch",
      "WebFetch(domain:docs.snowflake.com)",
      "WebFetch(domain:docs.databricks.com)",
      "WebFetch(domain:help.tableau.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "mcp__SpotterCode__get-rest-api-reference",
      "mcp__SpotterCode__get-developer-docs-reference"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/validate/check_audit_freshness.py --root . 2>/dev/null || true; b=$(git branch --show-current 2>/dev/null); [ \"$b\" = main ] && echo \"branch: main \u2014 branching.md: create a branch before editing\" || echo \"branch: ${b:-(detached)}\"",
            "async": false,
            "timeout": 20,
            "statusMessage": "Checking branch + audit freshness\u2026"
          }
        ]
      }
    ]
  }
}
