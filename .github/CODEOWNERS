# Code owners for files whose changes can silently weaken a confidentiality gate.
#
# Binding only when branch protection on `main` requires "Review from Code Owners"
# (a repository admin setting, not something this file can turn on).

# The customer-reference gate: its allowlists and grandfathered exemptions decide what
# may be published in this public repo; its tests pin what it must catch.
/tools/validate/check_customer_references.py                 @djwaldo
/tools/validate/tests/test_check_customer_references.py      @djwaldo
# The shared git helper the gate reads staged content and history through.
/tools/validate/_git.py                                      @djwaldo
# The secrets gate: CI's full-tree scan, and the scan the pr-ready skill runs on
# review text (`--file`) before it is appended to the evidence or shared.
/tools/validate/check_secrets.py                             @djwaldo

# Hooks and their installer: a change here can disable every local gate.
/scripts/install-hooks.sh                                    @djwaldo
/scripts/pre-commit.sh                                       @djwaldo
/scripts/commit-msg.sh                                       @djwaldo

# CI, where the gate is the backstop for --no-verify and uninstalled hooks.
/.github/workflows/validate.yml                              @djwaldo
# The single check list CI runs and the runner that runs it: dropping an entry, or
# marking one soft, removes a CI gate without touching the workflow.
/tools/validate/checks.py                                    @djwaldo
/tools/validate/run_checks.py                                @djwaldo
# The contributor's pre-PR run of the same list. The wrapper is thin: the logic and
# the evidence it writes are in the two Python files, and the interpreter choice
# (shared with pre-commit) is in the lib.
/scripts/pr-ready.sh                                         @djwaldo
/scripts/lib/python-bin.sh                                   @djwaldo
/tools/validate/pr_ready.py                                  @djwaldo
/tools/validate/evidence.py                                  @djwaldo

# The pr-ready skill and the reviewer it dispatches: the brief decides what a
# review looks for, so trimming it removes review areas without touching a gate.
/.claude/agents/pr-reviewer.md                               @djwaldo
/.claude/skills/pr-ready/                                    @djwaldo

# The SessionStart hook that warns when the git hooks are missing.
/.claude/settings.json                                       @djwaldo

# This file itself, so ownership cannot be removed without review.
/.github/CODEOWNERS                                          @djwaldo
