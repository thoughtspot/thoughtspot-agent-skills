guid: f0002f93-5ce2-5a16-9331-8a51c474983d
table:
  name: DM_PRODUCT
  description: Product catalog — paper, pens, furniture and office supplies
  db: DUNDERMIFFLIN
  schema: PUBLIC
  db_table: DM_PRODUCT
  connection:
    name: DUNDER_MIFFLIN_SNOWFLAKE
  columns:
  - name: PRODUCT_ID
    db_column_name: PRODUCT_ID
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: INT64
  - name: PRODUCT_NAME
    db_column_name: PRODUCT_NAME
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: VARCHAR
  - name: CATEGORY_ID
    db_column_name: CATEGORY_ID
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: INT64
  - name: LIST_PRICE
    db_column_name: LIST_PRICE
    properties:
      column_type: MEASURE
    db_column_properties:
      data_type: DOUBLE
  joins_with:
  - name: DM_PRODUCT_to_DM_CATEGORY
    destination:
      name: DM_CATEGORY
    'on': '[DM_PRODUCT::CATEGORY_ID] = [DM_CATEGORY::CATEGORY_ID]'
    type: INNER
    cardinality: MANY_TO_ONE
