guid: 474f0f33-e884-50fd-a7c0-01aa9aba3f60
table:
  name: DM_ORDER
  description: Order headers — one row per customer order
  db: DUNDERMIFFLIN
  schema: PUBLIC
  db_table: DM_ORDER
  connection:
    name: DUNDER_MIFFLIN_SNOWFLAKE
  columns:
  - name: ORDER_ID
    db_column_name: ORDER_ID
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: INT64
  - name: CUSTOMER_ID
    db_column_name: CUSTOMER_ID
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: INT64
  - name: EMPLOYEE_ID
    db_column_name: EMPLOYEE_ID
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: INT64
  - name: ORDER_DATE
    db_column_name: ORDER_DATE
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: DATE
  joins_with:
  - name: DM_ORDER_to_DM_CUSTOMER
    destination:
      name: DM_CUSTOMER
    'on': '[DM_ORDER::CUSTOMER_ID] = [DM_CUSTOMER::CUSTOMER_ID]'
    type: INNER
    cardinality: MANY_TO_ONE
  - name: DM_ORDER_to_DM_EMPLOYEE
    destination:
      name: DM_EMPLOYEE
    'on': '[DM_ORDER::EMPLOYEE_ID] = [DM_EMPLOYEE::EMPLOYEE_ID]'
    type: INNER
    cardinality: MANY_TO_ONE
  - name: DM_ORDER_to_DM_DATE_DIM
    destination:
      name: DM_DATE_DIM
    'on': '[DM_ORDER::ORDER_DATE] = [DM_DATE_DIM::DATE]'
    type: INNER
    cardinality: MANY_TO_ONE
