guid: 05b74ebd-2e01-5149-ab4c-382f42735704
table:
  name: DM_AUDIT_EVENT
  description: Order audit trail — every create/update/cancel, with who did it
  db: DUNDERMIFFLIN
  schema: PUBLIC
  db_table: DM_AUDIT_EVENT
  connection:
    name: DUNDER_MIFFLIN_SNOWFLAKE
  columns:
  - name: AUDIT_EVENT_ID
    db_column_name: AUDIT_EVENT_ID
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: INT64
  - name: ORDER_ID
    db_column_name: ORDER_ID
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: INT64
  - name: EVENT_TYPE
    db_column_name: EVENT_TYPE
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: VARCHAR
  - name: CREATED_BY_ID
    db_column_name: CREATED_BY_ID
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: INT64
  - name: UPDATED_BY_ID
    db_column_name: UPDATED_BY_ID
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: INT64
  - name: EVENT_DATE
    db_column_name: EVENT_DATE
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: DATE
  joins_with:
  - name: DM_AUDIT_EVENT_to_DM_ORDER
    destination:
      name: DM_ORDER
    'on': '[DM_AUDIT_EVENT::ORDER_ID] = [DM_ORDER::ORDER_ID]'
    type: INNER
    cardinality: MANY_TO_ONE
