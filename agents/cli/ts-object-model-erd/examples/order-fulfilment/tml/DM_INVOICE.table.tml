guid: a0a17f2d-ccb9-5e85-80f1-15766af0dc8c
table:
  name: DM_INVOICE
  description: Invoices raised against orders, with due and paid dates
  db: DUNDERMIFFLIN
  schema: PUBLIC
  db_table: DM_INVOICE
  connection:
    name: DUNDER_MIFFLIN_SNOWFLAKE
  columns:
  - name: INVOICE_ID
    db_column_name: INVOICE_ID
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: INT64
  - name: ORDER_ID
    db_column_name: ORDER_ID
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: INT64
  - name: INVOICE_DATE
    db_column_name: INVOICE_DATE
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: DATE
  - name: DUE_DATE
    db_column_name: DUE_DATE
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: DATE
  - name: PAID_DATE
    db_column_name: PAID_DATE
    properties:
      column_type: ATTRIBUTE
    db_column_properties:
      data_type: DATE
  - name: INVOICE_AMOUNT
    db_column_name: INVOICE_AMOUNT
    properties:
      column_type: MEASURE
    db_column_properties:
      data_type: DOUBLE
  - name: AMOUNT_PAID
    db_column_name: AMOUNT_PAID
    properties:
      column_type: MEASURE
    db_column_properties:
      data_type: DOUBLE
  joins_with:
  - name: DM_INVOICE_to_DM_ORDER
    destination:
      name: DM_ORDER
    'on': '[DM_INVOICE::ORDER_ID] = [DM_ORDER::ORDER_ID]'
    type: INNER
    cardinality: MANY_TO_ONE
