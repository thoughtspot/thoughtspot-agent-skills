answer:
  name: ZZ_probe_period_comparison_a_reuse_name_q
  tables:
  - id: '{model_name}'
    name: '{model_name}'
    fqn: '{model_guid}'
  formulas:
  - id: formula_Average Black Friday Sales
    name: Average Black Friday Sales
    expr: safe_divide ( sum_if ( [ZZ_probe_period_comparison_set] = 'Black Friday Days' , [Amount] ) , unique_count_if ( [ZZ_probe_period_comparison_set] = 'Black Friday Days' , date ( [Order Date] ) ) )
  - id: formula_Average Comparison Sales
    name: Average Comparison Sales
    expr: safe_divide ( sum_if ( [ZZ_probe_period_comparison_set] = '6 Prior Weeks' , [Amount] ) , unique_count_if ( [ZZ_probe_period_comparison_set] = '6 Prior Weeks' , date ( [Order Date] ) ) )
  - id: formula_Variance to Baseline
    name: Variance to Baseline
    expr: '[formula_Average Black Friday Sales] - [formula_Average Comparison Sales]'
  search_query: '[Order Date].yearly [formula_Average Black Friday Sales] [formula_Average Comparison Sales] [formula_Variance to Baseline] [Order Date] between [Order Date].01/01/2018 and [Order Date].12/31/2019 [ZZ_probe_period_comparison_set]'
  answer_columns:
  - name: Average Black Friday Sales
  - name: Average Comparison Sales
  - name: ZZ_probe_period_comparison_set
  - name: Variance to Baseline
  - name: Year(Order Date)
  table:
    table_columns:
    - column_id: Average Black Friday Sales
      show_headline: false
    - column_id: Average Comparison Sales
      show_headline: false
    - column_id: ZZ_probe_period_comparison_set
      show_headline: false
    - column_id: Variance to Baseline
      show_headline: false
    - column_id: Year(Order Date)
      show_headline: false
    ordered_column_ids:
    - Year(Order Date)
    - Average Black Friday Sales
    - Average Comparison Sales
    - ZZ_probe_period_comparison_set
    - Variance to Baseline
    client_state: ''
  display_mode: TABLE_MODE
