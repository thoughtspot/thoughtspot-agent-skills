# Credential and profile files
*.env
.env.*
*-profiles.json
*_profiles.json

# Private keys and certificates
*.pem
*.p8
*.key
*.pfx
*.p12

# Tokens and secrets
*token*.txt
*secret*.txt
*credentials*.json
*credentials*.yaml

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
dist/
build/
_site/

# macOS
.DS_Store

# Editor
*.swp
*.swo
.idea/
.vscode/

# Temp / test output files
/tmp/
*.tmp

# Tableau Hyper engine logs (created by tableauhyperapi in cwd)
hyperd.log

# Local test data
.data/

# AI tool local settings — ignore personal config, track shared project config
# (.claude/agents/, .claude/rules/, .claude/settings.json are committed; settings.local.json is not)
.cursor/
.claude/settings.local.json
.gemini/

# Per-machine smoke test configuration (model names, connection details, etc.)
tools/smoke-tests/smoke-config.local.json

# Leftovers from the CoCo Snowsight and Databricks Genie runtimes, retired 2026-11-08
# (tag runtimes-archive-2026-11-08). Nothing generates these any more; they stay
# ignored so a checkout that still has them on disk cannot commit them by accident:
# the CoCo stage-sync state file, the Genie bundle's deploy-time copy of agents/shared/,
# and the Genie notebook that build_mv_lib.py generated from tools/ts-cli.
.snowflake-deploy-sha
agents/databricks/shared/
agents/databricks/notebooks/databricks_mv_lib.py

# uv lockfile (local tool installs — not a project-level lockfile)
uv.lock

# Implementation plans — local working artifacts, not part of the published repo
# (design specs under docs/superpowers/specs/ ARE tracked; plans are not)
docs/superpowers/plans/

# Runtime output directories — `ts migrate audit -o ./plan/` and friends write here.
# Three such files were committed in f48a179 and sat in tools/ts-cli/plan/ carrying
# real instance GUIDs from a staging run (audit finding 1.1). Ignore the directory
# name wherever it appears, not just at the root.
plan/

# Transient review/agent worktrees (see BL-232 review, 2026-09-02)
wt-*/

# Round-trip fidelity study workspace (evidence + throwaway harness)
.svrt/

# Third-party formula-fidelity corpora (LibreOffice .fods, Apache POI .xls/.xlsx) and
# anything extracted from them. The user's rule (2026-10-06): they live OUTSIDE the repo
# (tools/formula-fidelity README "M1"); only manifests and redacted results are committed.
# These lines make a misplaced copy un-addable. Pinned by tools/formula-fidelity/tests.
formula-fidelity-data/
*.fods
*.fods.*
*.xls
*.xlsx
*.xlsm
**/*-m1-full.json
**/*excel*-full.json
**/candidates*.json*
**/crosscheck.json
**/PROVENANCE.md
**/COPYING.MPL

# Plain-text names fed to tools/quest/denylist.py add; only their hashes are committed.
names.txt

# Set TML from `ts sets inventory --export-tml`: group conditions carry warehouse values.
# Nothing like it is tracked; a deliberate fixture needs `git add -f`.
*.cohort.tml
