{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thoughtspot.github.io/thoughtspot-agent-skills/agentql-quest/quest.schema.json",
  "title": "AgentQL Quest data",
  "description": "What build.py compiles from encounters.yaml and the lesson capture, and what any front end plays: the page embeds it, and the build writes it beside the page as quest.json. Everything a front end needs is here and already checked, so it never parses the YAML or the capture. build.py --check fails when its output stops matching this schema, so a new field must be added here first. Bump schema_version on any change a front end would notice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "captured", "model", "realms", "routes"],
  "properties": {
    "schema_version": {"description": "1 for this layout.", "enum": [1]},
    "captured": {"description": "The date the lesson SQL was captured (YYYY-MM-DD).", "type": "string"},
    "model": {"description": "The ThoughtSpot Model the lesson SQL was captured on.", "type": "string"},
    "realms": {
      "description": "In map order. The first is where every player starts.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/realm"}
    },
    "routes": {
      "description": "Suggested paths across the map, per audience. Never enforced.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["who", "path"],
        "properties": {
          "who": {"type": "string"},
          "path": {"description": "Realm ids, in order.", "type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "$defs": {
    "texts": {"type": "array", "items": {"type": "string"}},
    "highlight": {
      "description": "Indexes of the lines to highlight, or \"all\".",
      "anyOf": [{"enum": ["all"]}, {"type": "array", "items": {"type": "integer"}}]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {"$ref": "#/$defs/texts"},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "cells"],
      "properties": {"label": {"type": "string"}, "cells": {"$ref": "#/$defs/texts"}}
    },
    "realm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "module", "depth", "minutes", "covers", "sealed", "scroll", "halls", "decree", "encounters"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "module": {"description": "The course module the realm teaches.", "type": "integer"},
        "depth": {"type": "string"},
        "minutes": {"type": "integer"},
        "covers": {"type": "string"},
        "sealed": {"description": "Shown on the map but not playable yet.", "type": "boolean"},
        "scroll": {"description": "The full comparison table, shown as the recap on the decree.", "anyOf": [{"$ref": "#/$defs/table"}, {"type": "null"}]},
        "halls": {"type": "array", "items": {"$ref": "#/$defs/hall"}},
        "decree": {"$ref": "#/$defs/texts"},
        "encounters": {"type": "array", "items": {"$ref": "#/$defs/encounter"}}
      }
    },
    "hall": {
      "description": "Teaches one idea with a slice of the scroll, then asks its trials.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "teach", "columns", "rows", "trials"],
      "properties": {
        "title": {"type": "string"},
        "teach": {"$ref": "#/$defs/texts"},
        "columns": {"$ref": "#/$defs/texts"},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
        "trials": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trial"}}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "why", "options", "correct"],
      "properties": {
        "kind": {"description": "claim: true or false. route: which engine.", "enum": ["claim", "route"]},
        "text": {"type": "string"},
        "why": {"type": "string"},
        "options": {"$ref": "#/$defs/texts"},
        "correct": {"description": "Index into options.", "type": "integer"}
      }
    },
    "encounter": {
      "description": "One quest: the business question, the path choice, the AgentQL, then the dragon's scales.",
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "lesson", "quest", "path", "agentql", "sql", "points", "takeaway"],
      "properties": {
        "case": {"description": "The lesson-sql.md case id.", "type": "string"},
        "lesson": {"type": "string"},
        "quest": {"type": "string"},
        "path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["options", "outcomes", "correct"],
          "properties": {
            "options": {"$ref": "#/$defs/texts"},
            "outcomes": {
              "description": "One per option. blocked costs no gold: the player chooses again.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "why"],
                "properties": {"kind": {"enum": ["win", "loss", "blocked"]}, "why": {"type": "string"}}
              }
            },
            "correct": {"type": "integer"}
          }
        },
        "agentql": {"description": "The AgentQL, one string per line.", "$ref": "#/$defs/texts"},
        "sql": {"description": "The captured warehouse SQL, one string per line.", "$ref": "#/$defs/texts"},
        "points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/point"}},
        "takeaway": {"type": "string"}
      }
    },
    "point": {
      "description": "One scale of the dragon: a question about the SQL.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ask", "hint", "lesson", "sqlHl", "scrollHl", "options", "correct", "rule", "ruleBy"],
      "properties": {
        "ask": {"type": "string"},
        "hint": {"type": "string"},
        "lesson": {"type": "string"},
        "sqlHl": {"$ref": "#/$defs/highlight"},
        "scrollHl": {"$ref": "#/$defs/highlight"},
        "options": {"$ref": "#/$defs/texts"},
        "correct": {"type": "integer"},
        "rule": {"description": "The rule the hoard lists, or \"\".", "type": "string"},
        "ruleBy": {"description": "Who adds the rule, or \"\" when there is none.", "enum": ["", "model", "thoughtspot", "agentql", "determinism"]}
      }
    }
  }
}
